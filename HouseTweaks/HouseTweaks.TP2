BEGIN ~House Tweaks: Cloak of Dragomir only decreases stats in daylight~ DESIGNATED 0017
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) ~This component must be installed on BG2:EE.~

//outdoor
	
APPEND ~splprot.2da~ ~C0SADAY 0x106 1 9~ UNLESS ~C0SADAY~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0SADAY~ BEGIN
	    SET C0SADAY = %row%
	  END
	END

EXTEND_TOP ~hexxat.bcs~ ~%MOD_FOLDER%/scripts/hexxat.baf~
EXTEND_TOP ~hexxa25.bcs~ ~%MOD_FOLDER%/scripts/hexxat.baf~
COPY ~%MOD_FOLDER%/items/hexxat~ ~override~
COPY_EXISTING ~OHHCLOA1.SPL~ ~OVERRIDE~
LPF ALTER_EFFECT INT_VAR match_opcode = 318 parameter2 = C0SADAY END
COPY_EXISTING ~OHHKORK1.SPL~ ~OVERRIDE~
LPF ALTER_EFFECT INT_VAR match_opcode = 318 parameter2 = C0SADAY END

